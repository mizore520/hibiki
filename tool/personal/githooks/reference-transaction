#!/bin/sh
# Fushi 个人护栏 G1/G2（reference-transaction，--no-verify 不能跳过）。
# 由 tool/personal/flow.ps1 install-hooks 安装；源码在 tool/personal/githooks/。
#
# G1 refs/heads/custom：任何移动都需要 FUSHI_APPROVE=adopt；非快进（改写历史）、
#    删除、改成符号引用一律拒绝，带标记也不行。
# G2 refs/heads/codex/*、refs/heads/pr/*：删除时如果提交既不在 custom 也不在
#    本地已知的远端跟踪分支上，需要 FUSHI_APPROVE=cleanup。
#
# 只看 refs/heads/custom 自身：普通提交经符号引用写入时，事务里出现的就是
# refs/heads/custom；以裸 HEAD 出现的只有“分离 HEAD”一类操作，与 custom 无关。
# 已知例外：git branch -C/-M 写入新名字时不经过事务，靠 custom 常驻主 checkout
# （git 拒绝覆盖已检出分支）和 GitHub 分支保护兜底。

if [ "$1" != "prepared" ]; then
  cat >/dev/null
  exit 0
fi

hook_dir=$(dirname "$0")
if [ ! -f "$hook_dir/fushi-lib.sh" ]; then
  echo "==== FUSHI GUARD BLOCKED: $hook_dir/fushi-lib.sh is missing; in the main checkout run: pwsh -File tool/personal/flow.ps1 install-hooks" >&2
  exit 1
fi
. "$hook_dir/fushi-lib.sh"
# lib 被截断或清空时函数不存在，不能继续执行（否则所有检查都会静默放行）。
command -v fushi_block_need_approval >/dev/null 2>&1 || {
  echo "==== FUSHI GUARD BLOCKED: $hook_dir/fushi-lib.sh is incomplete; in the main checkout run: pwsh -File tool/personal/flow.ps1 install-hooks" >&2
  exit 1
}

common_dir=$(git rev-parse --git-common-dir)

recovery_hint="先运行 git status：有进行中的 merge / cherry-pick / revert 就用对应的 --abort；否则用 git reset --merge HEAD 撤掉被拦操作已带进工作区的改动。"

# git pack-refs / gc 清理松散引用时，会把“同值已写入 packed-refs”的松散副本
# 作为删除上报。真删除一定持有 packed-refs.lock；清理阶段没有这个锁。
# 依赖 files 后端的行为，改用 reftable 时需重新验证。
is_loose_ref_prune() {
  [ ! -e "$common_dir/packed-refs.lock" ] &&
    grep -qxF "$1 $2" "$common_dir/packed-refs" 2>/dev/null
}

check_custom() {
  new=$1
  current=$(git rev-parse -q --verify refs/heads/custom 2>/dev/null)
  if fushi_is_zero_oid "$new"; then
    fushi_block "deleting branch custom is forbidden." \
      "禁止删除 custom 分支。" \
      "custom 是个人正式线，不能删除。"
  fi
  [ "$current" = "$new" ] && return 0
  if [ -n "$current" ] && ! git merge-base --is-ancestor "$current" "$new" 2>/dev/null; then
    fushi_block "rewriting custom history (non-fast-forward) is forbidden, even with approval. Recover with git status, then --abort or git reset --merge HEAD." \
      "禁止改写 custom 历史。" \
      "这次更新不是快进（reset / rebase / branch -f / amend 等）。" \
      "要撤销已合入的改动，从 custom 建分支用 git revert，再按采用流程合入。" \
      "$recovery_hint"
  fi
  if ! fushi_approved adopt; then
    fushi_block_need_approval adopt \
      "updating custom requires user consent (FUSHI_APPROVE=adopt). Recover first: git status, then --abort or git reset --merge HEAD." \
      "在 custom 上产生新提交需要用户同意。" \
      "合入 custom 前要向用户出示差异摘要并取得明确同意。" \
      "$recovery_hint"
  fi
}

check_branch_delete() {
  ref=$1
  current=$(git rev-parse -q --verify "$ref" 2>/dev/null) || return 0
  if git rev-parse -q --verify refs/heads/custom >/dev/null 2>&1 &&
    git merge-base --is-ancestor "$current" refs/heads/custom 2>/dev/null; then
    return 0
  fi
  if [ -n "$(git for-each-ref --count=1 --contains "$current" refs/remotes/ 2>/dev/null)" ]; then
    return 0
  fi
  fushi_approved cleanup && return 0
  fushi_block_need_approval cleanup \
    "deleting or renaming ${ref#refs/heads/} would drop commits not in custom or any known remote-tracking branch (FUSHI_APPROVE=cleanup)." \
    "删除（或改名）分支 ${ref#refs/heads/} 会丢掉未合入的提交。" \
    "该分支的提交既不在 custom，也不在本地已知的远端跟踪分支上（先 git fetch origin 可刷新）。" \
    "向用户列出这些提交（git log custom..${ref#refs/heads/}），确认可以丢弃后再删除。"
}

while read -r old new ref; do
  case "$old$new" in
    *ref:*)
      # 符号引用的切换（checkout 等）不涉及提交；但 custom 本身不能变成符号引用。
      if [ "$ref" = "refs/heads/custom" ]; then
        fushi_block "custom must stay a plain branch, not a symbolic ref." \
          "custom 不能变成符号引用。"
      fi
      continue
      ;;
  esac
  if fushi_is_zero_oid "$new" && ! fushi_is_zero_oid "$old" && is_loose_ref_prune "$old" "$ref"; then
    continue
  fi
  case "$ref" in
    refs/heads/custom)
      check_custom "$new"
      ;;
    refs/heads/codex/* | refs/heads/pr/*)
      if fushi_is_zero_oid "$new"; then
        check_branch_delete "$ref"
      fi
      ;;
  esac
done

exit 0
